<% if mode == "collections" %>

    <div class="dri_content_block_collection">
      <div>
        <div class="dri_collection_image">
          <% present(document, DRI::ImagePresenter) do |images| %>
            <% image = images.cover_image %>
            <% if image %>
              <%= image_tag image, width: "228", alt: "Collection"%>
            <% else %>
              <%= image_tag "no_image.png", width: "228", alt: "Collection" %>
            <% end %>
          <% end %>
        </div>
        <!-- close image -->
        <h1><%= document[:title_tesim][0] %></h1>
        <p class="dri_publishing_institute">
          <% unless document[:institute_tesim].nil? %>
              <%= document[:institute_tesim][0] %>
          <% end %>
        </p>
      </div>
      <div class="dri_num_objects">
          <span class="dri_object_text_num">
            <%= "#{t('dri.views.catalog.forms.objects_in_collection')} (#{document.total_objects_count})" %>
          </span>
      </div>
    </div>

<% else %>

    <div class="dri_content_block">
      <h1><%= document[:title_tesim][0] %></h1>
      <div class="dri_image">
        <% present(document, DRI::ImagePresenter) do |images| %>
          <%= image_tag images.image_for_search, width: "200", alt: "Content"%>
        <% end %>
      </div><!-- close image -->
      <p class="dri_subject">
        <% if document[:subject_tesim] %>
            <% document[:subject_tesim].each do |subject| %>
                <%= subject %>
                <% unless document[:subject_tesim].last == subject %> | <% end %>
            <% end %>
        <% else %>
            n/a
        <% end %>
      </p>
      <div class="dri_icon">
        <% present(document, DRI::ObjectPresenter) do |presenter| %>
          <% if presenter.file_type_labels != t("dri.data.types.Unknown") %>
            <span class="dri_icon_image">
              <% present(document, DRI::ImagePresenter) do |images| %>
                <% images.icons.each do |icon| %>
                  <%= image_tag(icon, alt: File.basename(icon.to_s, ".*").split("_")[-2]) %>
                <% end %>
              <% end %> &nbsp;
              <%= presenter.file_type_labels %>
            </span>
          <% else %>
            <!-- takes value from metadata -->
            <span class="dri_icon_text"><%= document[:object_type_ssm].first %></span>
          <% end %>
        <% end %>
      </div>
    </div>

<% end %>
