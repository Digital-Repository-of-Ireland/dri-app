<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <h1>The collection <%= @title %> is ready for you to download.</h1>
    <p>You can download the file <%= link_to "here", retrieve_archive_url(@object.alternate_id, @file) %>. Your file will be available until <%= (Time.now + Settings.archives.collection_dl_retention_period.days).strftime('%d %B %Y') %>.</p>
  </body>
</html>
